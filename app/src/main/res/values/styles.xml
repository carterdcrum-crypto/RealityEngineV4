<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#020610</item>
        <item name="android:navigationBarColor">#020610</item>
        <item name="android:statusBarColor">#020610</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#BCA1FF</item>
        <item name="android:textColorPrimary">#F6F8FF</item>
        <item name="android:textColorSecondary">#97A4C3</item>
        <item name="android:alertDialogTheme">@style/LucidPrismAlertDialog</item>
    </style>

    <style name="LucidPrismAlertDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">#0A1224</item>
        <item name="android:colorAccent">#BCA1FF</item>
        <item name="android:textColorPrimary">#F6F8FF</item>
        <item name="android:textColorSecondary">#97A4C3</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
